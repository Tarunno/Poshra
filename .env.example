# Local development settings. Copy to .env (`make env`) and change the passwords.
# .env is git-ignored; never commit real secrets.

COMPOSE_PROJECT_NAME=poshra

# --- Postgres (one server, one database + role per service) ---
POSTGRES_IMAGE=postgis/postgis:17-3.5
POSTGRES_HOST_PORT=55432
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser

MARKETPLACE_DB_PASSWORD=change-me-marketplace
CHECKOUT_DB_PASSWORD=change-me-checkout
INVENTORY_DB_PASSWORD=change-me-inventory
ASSISTANT_DB_PASSWORD=change-me-assistant

# --- marketplace (Django) ---
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false

# --- Kong gateway ---
KONG_IMAGE=kong:3.9.3
KONG_PROXY_HOST_PORT=8080
KONG_ADMIN_HOST_PORT=8001

# --- JWT signing keys ---
# Generate a dev pair with:
#   make jwt-keys
JWT_PRIVATE_KEY_B64=change-me-base64-pkcs8-pem
JWT_PUBLIC_KEY_B64=change-me-base64-spki-pem
JWT_KEY_ID=poshra-dev-1
# Secure cookies need HTTPS; keep false only for plain-HTTP local development.
AUTH_COOKIE_SECURE=false
